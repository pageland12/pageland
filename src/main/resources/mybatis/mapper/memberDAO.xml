<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper 
	PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.springboot.pageland.dao.IMemberDAO">
	<select id="memberList" resultType="com.springboot.pageland.dto.MemberDTO">
		SELECT *
		  FROM MEMBER
		 ORDER BY BNO DESC
	</select>
	
	<select id="findByEmail" resultType="com.springboot.pageland.dto.MemberDTO">
		SELECT *
		  FROM MEMBER
		 WHERE MEMAIL=#{memail}
  </select>
	<select id="memberView" resultType="com.springboot.pageland.dto.MemberDTO">
		SELECT *
		  FROM MEMBER
		  WHERE mno = #{mno}
	</select>
	
	<insert id="memberInsert">
		INSERT INTO MEMBER(MNO,MEMAIL,MPASSWD,MNAME,MADDR,MTEL,MACCOUNT,MGRADE,MDATE,MPOINT)
		 VALUES(MEMBER_SEQ.NEXTVAL,#{memail},#{mpasswd},#{mname},#{maddr},#{mtel},#{maccount},
		 'NORMAL',SYSDATE,0)
	</insert>
	
	<update id="memberUpdate">
		UPDATE MEMBER
		   SET MNAME=#{mname},MADDR=#{maddr},MTEL=#{mtel},MACCOUNT=#{maccount}
		 WHERE MNO=#{mno}
	</update>
	
	<delete id="memberDelete">
		DELETE FROM MEMBER
		 WHERE MNO=#{mno}
	</delete>
	
	<select id="findByEmail" resultType="com.springboot.pageland.dto.MemberDTO">
		SELECT *
		  FROM MEMBER
		  WHERE MEMAIL = #{memail}
	</select>
</mapper>