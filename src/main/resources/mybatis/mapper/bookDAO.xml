<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper 
	PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.springboot.pageland.dao.IBookDAO">
	<select id="bookList" resultType="com.springboot.pageland.dto.BookDTO">
		SELECT *
		  FROM BOOK
		 ORDER BY BNO DESC
	</select>
	
	<select id="bookDetail" resultType="com.springboot.pageland.dto.BookDTO">
		SELECT *
		  FROM BOOK
		 WHERE BNO=#{bno}
	</select>
	

	<insert id="bookInsert">
		INSERT INTO BOOK(BNO,BNAME,BPRICE,BAGE,BGENRE,BPUBLISHER,BIMG,BINFO,BSTOCK,BLIKE)
		 VALUES(BOOK_SEQ.NEXTVAL,#{bname},#{bprice},#{bage},#{bgenre},#{bpublisher},#{bimg},#{binfo},
		 		#{bstock},0)
	</insert>
	
	<update id="bookUpdate">
		UPDATE BOOK
		   SET BNAME=#{bname},BPRICE=#{bprice},BAGE=#{bage},BGENRE=#{bgenre},BPUBLISHER=#{bpublisher},
		   		   	   BIMG=#{bimg},BSTOCK=#{bstock},BLIKE=#{blike}
		 WHERE BNO=#{bno}
	</update>
	
	<delete id="bookDelete">
		DELETE FROM BOOK
		 WHERE BNO=#{bno}
	</delete>
	
	<select id="bestList" resultType="com.springboot.pageland.dto.BookDTO">
	SELECT *
	  FROM (
	  		SELECT * 
	  		  FROM BOOK 
	  		 ORDER BY BLIKE DESC, BNO DESC
	  	   )
	<![CDATA[
	 WHERE ROWNUM <= 16
	]]>
	</select>
	
	<select id="bookListByCategory" resultType="com.springboot.pageland.dto.BookDTO">
	    SELECT * FROM book 
	    WHERE bage LIKE '%' || #{category} || '%'
	    ORDER BY bno DESC
	</select>
	
	<!-- 분야별(bgenre) 필터링 쿼리 -->
	<select id="bookListByGenre" resultType="com.springboot.pageland.dto.BookDTO">
	    SELECT * FROM book 
	    WHERE bgenre LIKE '%' || #{genre} || '%'
	    ORDER BY bno DESC
	</select>
	
	<!-- 출판사별(bpublisher) 필터링 쿼리 -->
	<select id="bookListByPublisher" resultType="com.springboot.pageland.dto.BookDTO">
	    SELECT * FROM book 
	    WHERE bpublisher LIKE '%' || #{publisher} || '%'
	    ORDER BY bno DESC
	</select>
	
	<!-- 전체 도서 페이징 목록 -->
	<select id="bookListPaging" resultType="com.springboot.pageland.dto.BookDTO">
		SELECT *
	  	  FROM (
	  	  	SELECT INNER_LIST.*, ROWNUM AS RNUM
	  		  FROM (
	  		  	SELECT * 
	  		  		FROM BOOK 
	  		  		ORDER BY BNO DESC
	  		  ) INNER_LIST
	      )
	      	WHERE RNUM BETWEEN #{startRow} AND #{endRow}
	</select>

	<!-- 전체 도서 개수 조회 (페이지 번호 계산용) -->
	<select id="getTotalCount" resultType="int">
		SELECT COUNT(*) FROM BOOK
	</select>

</mapper>