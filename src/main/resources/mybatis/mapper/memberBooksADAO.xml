<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper 
	PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.springboot.pageland.dao.IMemberBooksDAO">
	<insert id="memberBooksInsert">
		INSERT INTO MEMBER_BOOKS(MBNO,MBSTART,MBEND,MBRETURN,MBEXTENSION,MBLATEDATE,MBLATEFEE,MBSTATUS,MNO,OLNO,BNO,MPNO)
		 VALUES(MB_SEQ.NEXTVAL,#{mbstart},#{mbend},null,0,0,0,'대여중',#{mno},#{olno},#{bno},#{mpno, jdbcType=INTEGER})
	</insert>
	
</mapper>