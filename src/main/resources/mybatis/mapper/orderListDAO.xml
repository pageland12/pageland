<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper 
	PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.springboot.pageland.dao.IOrderListDAO">
	<select id="morderList" resultType="com.springboot.pageland.dto.OrderListDTO">
		SELECT *
		  FROM ORDER_LIST
		 WHERE MNO=#{mno}
		 ORDER BY OLDATE DESC
	</select>
	
	
	<insert id="orderListInsert">
		INSERT INTO ORDER_LIST(OLNO,OLPRICE,OLFEE,OLSALE,OLTOTAL,OLPAYMENT,OLDATE,MNO)
		 VALUES(#{olno},#{olprice},#{olfee},#{olsale},#{oltotal},#{olpayment},SYSDATE,#{mno})
	</insert>
	
</mapper>