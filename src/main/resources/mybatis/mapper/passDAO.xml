<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper 
	PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.springboot.pageland.dao.IPassDAO">
	<select id="passList" resultType="com.springboot.pageland.dto.PassDTO">
		SELECT *
		  FROM PASS
		 ORDER BY PNO DESC
	</select>
	
	<select id="passDetail" resultType="com.springboot.pageland.dto.PassDTO">
		SELECT *
		  FROM PASS
		 WHERE PNO=#{pno}
	</select>
	
	<insert id="passInsert">
		INSERT INTO PASS(PNO,PNAME,PPRICE,PTYPE,PPERIOD,PCOUNT,PIMG,PINFO)
		 VALUES(PASS_SEQ.NEXTVAL,#{pname},#{pprice},#{ptype},#{pperiod, jdbcType=INTEGER},#{pcount, jdbcType=INTEGER},#{pimg},#{pinfo})
	</insert>
	
	<update id="passUpdate">
		UPDATE PASS
		   SET PNAME=#{pname},PPRICE=#{pprice},PTYPE=#{ptype},PPERIOD=#{pperiod},BCOUNT=#{pcount},
		   		   	   PIMG=#{pimg},PINFO=#{pinfo}
		 WHERE PNO=#{pno}
	</update>
	
	<delete id="passDelete">
		DELETE FROM PASS
		 WHERE PNO=#{pno}
	</delete>
</mapper>